---
import BaseLayout from "./BaseLayout.astro";
import ClosingSection from "../components/ClosingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import MetricsSection from "../components/MetricsSection.astro";
import UseGridSection from "../components/UseGridSection.astro";
import { validateUseCaseFrontmatter } from "../lib/validateUseCaseFrontmatter";

const { frontmatter: rawFrontmatter, file } = Astro.props;
const frontmatter = validateUseCaseFrontmatter(rawFrontmatter, file);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: frontmatter.schema.name,
  description: frontmatter.schema.description,
  mainEntity: {
    "@type": "WebAPI",
    name: frontmatter.schema.mainEntityName,
    description: frontmatter.schema.mainEntityDescription,
    provider: {
      "@type": "Organization",
      name: frontmatter.schema.providerName
    },
    documentation: "#endpoint",
    termsOfService: "#faq"
  }
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  bodyClass={frontmatter.bodyClass}
  themeColor={frontmatter.themeColor}
  ogTitle={frontmatter.ogTitle}
  ogDescription={frontmatter.ogDescription}
  jsonLd={jsonLd}
>
  <main>
    <Hero data={frontmatter.hero} />
    <MetricsSection data={frontmatter.trust} />
    <UseGridSection data={frontmatter.useCases} variant="useCases" />
    <ClosingSection data={frontmatter.cta} />
    <FaqSection data={frontmatter.faq} />
  </main>
  <Footer data={frontmatter.footer} />
</BaseLayout>
