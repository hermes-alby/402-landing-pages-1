---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["pipeline"];
}

const { data } = Astro.props;
---

<section class="section" id="how">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="sec-title">
          {data.title.text}<em>{data.title.highlight}</em>
        </h2>
      </div>
      <p class="sec-desc">{data.description}</p>
    </div>

    <div class="pipeline">
      {data.stages.map((stage, idx) => (
        <>
          <div class="pipe-stage">
            <span class="ix"><b>{stage.ix}</b></span>
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
          </div>
          {idx < data.stages.length - 1 && <div class="pipe-arrow">→</div>}
        </>
      ))}
    </div>

    <div class="pipe-foot">
      {data.foot.map((cell) => (
        <div class="cell">
          <span class="k">{cell.label}</span>
          <span class="v" set:html={cell.html}></span>
        </div>
      ))}
    </div>
  </div>
</section>
