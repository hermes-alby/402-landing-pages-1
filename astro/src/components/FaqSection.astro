---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["faq"];
}

const { data } = Astro.props;
---

<section class="section" id="faq" style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="sec-title">{data.title}</h2>
      </div>
      <p class="sec-desc">{data.description}</p>
    </div>

    <div class="faq-list">
      {data.items.map((item) => (
        <details class="faq-item" open={item.open}>
          <summary>
            <h4>{item.question}</h4>
            <div class="ic">+</div>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
