---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["trust"];
}

const { data } = Astro.props;
---

<section class="trust">
  <div class="wrap">
    <div class="trust-grid">
      {data.items.map((item) => (
        <div class="trust-cell">
          <span class="lbl">{item.label}</span>
          <span class="stat">
            {item.stat}<em>{item.statHighlight}</em>{item.statSuffix && ` ${item.statSuffix}`}
          </span>
          <span class="desc">{item.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>
