---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["flow"];
}

const { data } = Astro.props;
---

<section class="section section--flow" id="flow" style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow eyebrow--center">{data.eyebrow}</span>
      <h2 class="sec-title">
        {data.title.text}<em>{data.title.highlight}</em>
      </h2>
    </div>

    <div class="flow-steps">
      {data.steps.map((step) => (
        <div class="flow-step">
          <div class="num">{step.number}</div>
          <h4>{step.title}</h4>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
