---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["comparison"];
}

const { data } = Astro.props;
---

<section class="section" id="compare" style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="sec-title" set:html={data.title}></h2>
      </div>
      <p class="sec-desc">{data.description}</p>
    </div>

    <div class="compare">
      <div class="compare-row head">
        <div></div>
        <div class="us">{data.columns.us}</div>
        <div>{data.columns.a}</div>
        <div>{data.columns.b}</div>
      </div>
      {data.rows.map((row) => (
        <div class="compare-row">
          <div class="label">{row.category}</div>
          <div class="us"><span class="cell">{row.us}</span></div>
          <div><span class="cell">{row.left}</span></div>
          <div><span class="cell">{row.right}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>
