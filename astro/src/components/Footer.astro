---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["footer"];
}

const { data } = Astro.props;
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="mark">{data.brand.charAt(0)}</div>
      <span>{data.brand}</span>
      <span style="color: var(--ink-3); margin: 0 6px;">·</span>
      <span style="color: var(--ink-2); font-weight: 500;">{data.suffix}</span>
    </div>
    <span class="footer-tag">{data.tag}</span>
  </div>
</footer>
