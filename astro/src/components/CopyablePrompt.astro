---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["prompt"];
}

const { data } = Astro.props;
---

<section class="section" id="prompt" style="padding-top: 0;">
  <div class="wrap">
    <div class="prompt-layout">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="sec-title">{data.title}</h2>
        <p>{data.text}</p>
        <button class="copy-button" type="button" data-copy-target={data.copyTarget}>
          {data.buttonLabel}
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <pre class="code-block" id={data.copyTarget}><code>{data.code}</code></pre>
    </div>
  </div>
</section>
