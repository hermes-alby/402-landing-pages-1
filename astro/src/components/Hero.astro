---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["hero"];
}

const { data } = Astro.props;
---

<header class="hero">
  <div class="wrap">
    <div class="ghost-number" aria-hidden="true">{data.ghostNumber}</div>
    <div class="hero-grid">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h1 class="display">
          {data.title.lines.map((line, i) => (
            <>
              {line}
              {i < data.title.lines.length - 1 && <br />}
            </>
          ))}
          <em>{data.title.highlight}</em>
        </h1>
        <p class="hero-sub">{data.lead}</p>
        <ul class="hero-meta">
          {data.meta.map((item) => (
            <li>
              <span class="tick">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="connect-stage">
        <svg class="connect-wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="wire" d="M 0 42 L 100 42" vector-effect="non-scaling-stroke" />
          <path class="wire wire-rev" d="M 0 58 L 100 58" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="node-card node-agent">
          <span class="node-eyebrow">{data.connection.agent.eyebrow}</span>
          <div class="node-logo">{data.connection.agent.logo}</div>
          <div class="node-title">{data.connection.agent.title}</div>
        </div>

        <div class="node-card node-service">
          <span class="node-eyebrow">{data.connection.service.eyebrow}</span>
          <div class="node-logo">{data.connection.service.logo}</div>
          <div class="node-title">{data.connection.service.title}</div>
        </div>
      </div>
    </div>
  </div>
</header>
