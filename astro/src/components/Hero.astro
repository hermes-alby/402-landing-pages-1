---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["hero"];
}

const { data } = Astro.props;
---

<header class="hero">
  <div class="wrap">
    <div class="ghost-number" aria-hidden="true">{data.ghostNumber}</div>
    <div class="hero-grid">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h1 class="display">
          {data.title.lines.map((line, i) => (
            <>
              {line}
              {i < data.title.lines.length - 1 && <br />}
            </>
          ))}
          <em>{data.title.highlight}</em>
        </h1>
        <p class="hero-sub">{data.lead}</p>
        <div class="hero-cta">
          {data.actions.map((action) => (
            <a class:list={["btn", "btn-lg", action.primary ? "btn-primary" : "btn-ghost"]} href={action.href}>
              {action.monoTag && <span class="mono-tag">{action.monoTag}</span>}
              {action.text}
            </a>
          ))}
        </div>
        <ul class="hero-meta">
          {data.meta.map((item) => (
            <li>
              <span class="tick">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="result-stage">
        <div class="prompt-bubble">
          <span class="lbl">{data.promptLabel}</span>
          {data.promptText}
          <span class="stem"></span>
        </div>

        <div class="result-card">
          <div class="rc-head">
            <div class="rc-brand">
              <div class="rc-brand-dot">{data.profile.brand.charAt(0).toUpperCase()}</div>
              <span>{data.profile.brand} <em>/ {data.profile.brandSuffix}</em></span>
            </div>
            <div class="rc-status">{data.profile.status}</div>
          </div>

          <div class="rc-profile">
            <div class="rc-avatar" data-initials={data.profile.initials}></div>
            <div>
              <div class="rc-name">{data.profile.name}</div>
              <div class="rc-role">{data.profile.role}</div>
              <div class="rc-loc">{data.profile.meta}</div>
            </div>
          </div>

          <div class="rc-data">
            {data.profile.rows.map((row) => (
              <div class="rc-row">
                <span class="k">{row.label}</span>
                <span class="v">
                  {row.value}
                  {row.verified && <span class="verified">✓ verified</span>}
                </span>
              </div>
            ))}
          </div>

          <div class="rc-tags">
            {data.profile.tags.map((tag) => <span class="rc-tag">{tag}</span>)}
          </div>

          <div class="rc-foot">
            <span>{data.profile.footLeft}</span>
            <span class="price">{data.profile.footRight}</span>
          </div>
        </div>

        <div class="result-label">
          <span>{data.resultLabel}</span>
          <span>{data.resultMeta}</span>
        </div>
      </div>
    </div>
  </div>
</header>
