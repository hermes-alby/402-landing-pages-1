---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["facts"];
}

const { data } = Astro.props;
---

<section class="section" id="endpoint" style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="sec-title">{data.title}</h2>
      </div>
      <p class="sec-desc">{data.text}</p>
    </div>

    <div class="facts-panel">
      <dl>
        {data.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
